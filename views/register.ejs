<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">
    <title>Document</title>
</head>

<body class="min-h-screen flex items-center justify-center bg-[#020100] p-4">

    <form action="/register" method="post"
     class="w-full max-w-sm rounded-2xl border border-[#eee5e5] bg-white p-8 shadow-xl">

        <div class="mb-7 flex items-center gap-3">
            <div class="flex h-10 w-10 rotate-45 items-center justify-center bg-[#6d1735]">
                <div class="h-3 w-3 border-2 border-white"></div>
            </div>
            <div>
                <h1 class="text-2xl font-semibold text-[#6d1735]">Create Account</h1>
            </div>
        </div>

        <label class="mb-1 block text-sm font-medium text-gray-700">Username</label>
        <input type="text" placeholder="Enter username" required name="username"
            class="mb-5 w-full rounded-lg border border-gray-200 px-4 py-3 outline-none focus:border-[#6d1735] focus:ring-2 focus:ring-[#6d1735]/10">

        <label class="mb-1 block text-sm font-medium text-gray-700">Email</label>
        <input type="email" placeholder="you@example.com" required name="email"
            class="mb-5 w-full rounded-lg border border-gray-200 px-4 py-3 outline-none focus:border-[#6d1735] focus:ring-2 focus:ring-[#6d1735]/10">

        <label class="mb-1 block text-sm font-medium text-gray-700">Password</label>
        <input type="password" placeholder="Enter password" required name="password"
            class="mb-6 w-full rounded-lg border border-gray-200 px-4 py-3 outline-none focus:border-[#6d1735] focus:ring-2 focus:ring-[#6d1735]/10">

        <button type="submit"
            class="w-full rounded-lg bg-[#6d1735] py-3 font-semibold text-white shadow-lg transition duration-300 hover:scale-[1.03] hover:bg-[#a13b5d]">
            Create Account →
        </button>
    </form>

</body>

</html>