<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | Social</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="/css/effects.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="/js/canvas-3d.js" defer></script>
    <script src="/js/tilt-3d.js" defer></script>
    <script src="/js/animations.js" defer></script>
</head>

<body class="min-h-screen flex items-center justify-center p-4 bg-[#070a14] text-slate-100">

    <!-- Ambient Glow Orbs -->
    <div class="ambient-glow w-96 h-96 bg-violet-600 top-20 right-1/3"></div>

    <form action="/register" method="post"
        data-tilt
        data-tilt-max="9"
        class="auth-card glass-panel w-full max-w-sm rounded-3xl p-8 preserve-3d">

        <div class="mb-7 text-center layer-depth-3">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-linear-to-tr from-violet-600 to-cyan-500 text-2xl font-black text-white shadow-xl shadow-cyan-500/30">
                S
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-white">Create Account</h1>
            <p class="mt-2 text-sm text-slate-400">Join the next-generation social stream</p>
        </div>

        <div class="layer-depth-2 mb-4">
            <label class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-300">Username</label>
            <input type="text" placeholder="yourusername" required name="username"
                class="w-full rounded-xl border border-white/10 bg-slate-900/60 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
        </div>

        <div class="layer-depth-2 mb-4">
            <label class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-300">Email Address</label>
            <input type="email" placeholder="you@example.com" required name="email"
                class="w-full rounded-xl border border-white/10 bg-slate-900/60 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
        </div>

        <div class="layer-depth-2 mb-6">
            <label class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-300">Password</label>
            <input type="password" placeholder="••••••••" required name="password"
                class="w-full rounded-xl border border-white/10 bg-slate-900/60 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
        </div>

        <div class="layer-depth-3">
            <button type="submit"
                class="w-full rounded-xl bg-linear-to-r from-violet-600 to-cyan-500 py-3.5 font-bold text-white shadow-lg shadow-cyan-500/25 transition duration-300 hover:shadow-cyan-500/40 hover:scale-[1.02] active:scale-[0.98]">
                Create Account →
            </button>
        </div>

        <p class="mt-6 text-center text-sm text-slate-400 layer-depth-1">
            Already have an account?
            <a href="/login" class="font-semibold text-cyan-400 hover:text-cyan-300 underline underline-offset-4 transition">
                Login
            </a>
        </p>
    </form>

</body>

</html>
