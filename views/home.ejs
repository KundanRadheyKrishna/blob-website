<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social Feed</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="/css/effects.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="/js/canvas-3d.js" defer></script>
    <script src="/js/tilt-3d.js" defer></script>
    <script src="/js/animations.js" defer></script>
</head>

<body class="min-h-screen text-slate-100 bg-[#070a14] selection:bg-cyan-500 selection:text-white">

    <!-- Ambient Glow Orbs -->
    <div class="ambient-glow w-96 h-96 bg-cyan-500 top-10 left-1/4"></div>
    <div class="ambient-glow w-96 h-96 bg-violet-600 top-1/2 right-10"></div>

    <!-- 3D Glass Navbar -->
    <header class="sticky top-0 z-40 flex h-16 items-center justify-between glass-nav px-6 lg:px-12">

        <a href="/" class="flex items-center gap-2 group">
            <div class="h-9 w-9 rounded-xl bg-linear-to-trm-cyan-500 to-blue-600 flex items-center justify-center font-black text-white shadow-lg shadow-cyan-500/30 group-hover:scale-105 transition duration-300">
                S
            </div>
            <span class="text-2xl font-extrabold tracking-tight text-white group-hover:text-cyan-400 transition">
                Social<span class="text-cyan-400">.</span>
            </span>
        </a>

        <div class="flex items-center gap-3">

            <% if (isLoggedIn) { %>

                <!-- User logged in -->
                <a href="/post" class="rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 px-4 py-2 font-medium text-white shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-[1.02] active:scale-[0.98] transition">
                    + Create Post
                </a>

                <form action="/logout" method="post">
                    <button type="submit" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 hover:bg-white/10 hover:text-white transition">
                        Logout
                    </button>
                </form>

            <% } else { %>

                <!-- User not logged in -->
                <a href="/login" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 hover:bg-white/10 hover:text-white transition">
                    Login
                </a>

                <a href="/register" class="rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 px-4 py-2 font-medium text-white shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-[1.02] active:scale-[0.98] transition">
                    Create Account
                </a>

            <% } %>

        </div>

    </header>


    <!-- Main Feed -->
    <main class="mx-auto max-w-7xl px-4 py-8 lg:px-8">
        
        <div class="mb-6 flex items-center justify-between">
            <h1 class="text-xl font-bold tracking-wide text-slate-200">
                Live Community Feed
            </h1>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                <%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %>
            </span>
        </div>

        <!-- All Posts: Visible to everyone -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 perspective-1500">
            <% posts.forEach(post => { %>

                <article
                    data-tilt
                    data-tilt-max="7"
                    class="post-card glass-panel rounded-2xl overflow-hidden preserve-3d flex flex-col justify-between">

                    <div>
                        <!-- Author Header -->
                        <div class="p-4 flex items-center gap-3 border-b border-white/5 layer-depth-1">
                            <div class="h-10 w-10 rounded-full bg-linear-to-tr from-cyan-500/20 to-violet-500/20 border border-cyan-500/30 flex items-center justify-center font-bold text-cyan-400 text-sm">
                                <%= (post.username?.[0]?.username || 'U')[0].toUpperCase() %>
                            </div>
                            <div>
                                <h2 class="font-bold text-slate-100 text-sm leading-tight">
                                    <%= post.username?.[0]?.username || 'Unknown User' %>
                                </h2>
                                <span class="text-[11px] text-slate-400">Community Member</span>
                            </div>
                        </div>

                        <!-- Written Post -->
                        <div class="p-4 layer-depth-2">
                            <p class="text-sm text-slate-300 leading-relaxed whitespace-pre-wrap">
                                <%= post.content %>
                            </p>
                        </div>
                    </div>

                    <div>
                        <!-- Image Section -->
                        <% if (post.imageUrl) { %>
                            <div class="px-4 pb-2 layer-depth-2">
                                <div class="overflow-hidden rounded-xl border border-white/10 bg-slate-900/60 aspect-video w-full flex items-center justify-center">
                                    <img src="<%= post.imageUrl %>" alt="Post image" width="600" height="338"
                                        class="w-full h-full object-cover rounded-xl hover:scale-105 transition duration-500 aspect-video" loading="lazy">
                                </div>
                            </div>
                        <% } %>

                        <!-- Like & Delete Buttons -->
                        <div class="flex items-center justify-between p-4 border-t border-white/5 layer-depth-3">
                            <button type="button" class="flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition group">
                                <span class="group-hover:scale-125 transition duration-200">♥</span>
                                <span>Like</span>
                            </button>

                            <% if ( currentUserId && post.user && String(post.user._id) === currentUserId ) { %>
                                <button type="button" class="text-xs font-semibold text-rose-400 hover:text-rose-300 transition">
                                    Delete
                                </button>
                            <% } %>
                        </div>
                    </div>

                </article>

            <% }) %>

        </section>

    </main>

</body>

</html>
