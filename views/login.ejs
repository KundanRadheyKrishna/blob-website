
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">
    <title>Login</title>
</head>

<body class="min-h-screen flex items-center justify-center bg-linear-to-br from-blue-950 via-blue-800 to-sky-500 p-4">

    <!-- Login Form -->
    <form action="/login" method="post"
        class="w-full max-w-sm rounded-2xl border border-white/30 bg-white/10 p-8 shadow-2xl backdrop-blur-xl">

        <!-- Heading -->
        <div class="mb-8 text-center">

            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-white/40 bg-white/20 text-2xl font-bold text-white">
                S
            </div>

            <h1 class="text-3xl font-bold text-white">
                Welcome Back
            </h1>

            <p class="mt-2 text-sm text-blue-100">
                Login to your account
            </p>

        </div>


        <!-- Email -->
        <label class="mb-2 block text-sm font-medium text-white">
            Email
        </label>

        <input
            type="email"
            name="email"
            placeholder="Enter your email"
            required
            class="mb-5 w-full rounded-lg border border-white/30 bg-white/10 px-4 py-3 text-white outline-none placeholder:text-blue-100 focus:border-white focus:ring-2 focus:ring-white/20"
        >


        <!-- Password -->
        <label class="mb-2 block text-sm font-medium text-white">
            Password
        </label>

        <input
            type="password"
            name="password"
            placeholder="Enter your password"
            required
            class="mb-6 w-full rounded-lg border border-white/30 bg-white/10 px-4 py-3 text-white outline-none placeholder:text-blue-100 focus:border-white focus:ring-2 focus:ring-white/20"
        >


        <!-- Submit -->
        <button
            type="submit"
            class="w-full rounded-lg bg-white py-3 font-bold text-blue-700 transition hover:bg-blue-100"
        >
            Login →
        </button>


        <!-- Register Link -->
        <p class="mt-6 text-center text-sm text-blue-100">

            Don't have an account?

            <a href="/register" class="font-bold text-white underline">
                Create Account
            </a>

        </p>

    </form>

</body>
</html>
