<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Post | Social</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="/css/effects.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="/js/canvas-3d.js" defer></script>
    <script src="/js/tilt-3d.js" defer></script>
    <script src="/js/animations.js" defer></script>
</head>

<body class="min-h-screen bg-[#070a14] text-slate-100 flex items-center justify-center p-4">

    <!-- Ambient Glow Orbs -->
    <div class="ambient-glow w-96 h-96 bg-cyan-500 top-1/4 left-1/3"></div>

    <div class="w-full max-w-xl preserve-3d">

        <div class="mb-6 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-cyan-400 transition">
                ← Back to Feed
            </a>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                New Post
            </span>
        </div>

        <% if (isLoggedIn) { %>

            <form action="/posts" enctype="multipart/form-data" method="POST"
                data-tilt
                data-tilt-max="6"
                class="auth-card glass-panel rounded-3xl p-6 sm:p-8 preserve-3d">

                <h1 class="text-2xl font-bold tracking-tight text-white mb-6 layer-depth-2">
                    Share with the Community
                </h1>

                <!-- Content Area -->
                <div class="layer-depth-1 mb-5">
                    <textarea name="content" placeholder="What's happening in your universe?" maxlength="2000" required
                        class="min-h-36 w-full resize-y rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-white placeholder-slate-500 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 leading-relaxed"></textarea>
                </div>

                <!-- Interactive Dropzone -->
                <div class="layer-depth-2 mb-6">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                        Attachment (Optional)
                    </label>

                    <div id="dropzone"
                        class="relative rounded-2xl border-2 border-dashed border-white/15 bg-white/2 p-6 text-center transition hover:border-cyan-400/50 hover:bg-cyan-500/5 cursor-pointer">
                        <input type="file" name="image" id="image" accept="image/jpeg,image/png,image/webp"
                            class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                        
                        <div class="flex flex-col items-center justify-center gap-2 pointer-events-none">
                            <div class="h-10 w-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 text-lg">
                                ☁
                            </div>
                            <p class="text-sm font-medium text-slate-300">
                                Click or drag an image here
                            </p>
                            <p class="text-xs text-slate-500">
                                Supports JPG, PNG, WEBP (Max 5MB)
                            </p>
                        </div>
                    </div>

                    <!-- Live Image Preview -->
                    <div id="preview-container" class="mt-4 hidden overflow-hidden rounded-2xl border border-cyan-500/30 max-h-60 items-center justify-center bg-slate-900/80">
                        <img id="preview-image" src="" alt="Preview" class="w-full h-full object-cover">
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex items-center justify-between pt-2 border-t border-white/10 layer-depth-3">
                    <a href="/" class="rounded-xl border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-medium text-slate-300 hover:bg-white/10 hover:text-white transition">
                        Cancel
                    </a>

                    <button type="submit"
                        class="rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 px-6 py-2.5 font-bold text-white shadow-lg shadow-cyan-500/25 transition duration-300 hover:shadow-cyan-500/40 hover:scale-[1.02] active:scale-[0.98]">
                        Publish Post →
                    </button>
                </div>

            </form>

        <% } else { %>

            <div class="glass-panel rounded-3xl p-8 text-center preserve-3d">
                <h2 class="text-xl font-bold text-white mb-2">Authentication Required</h2>
                <p class="text-sm text-slate-400 mb-6">Please login to create and publish posts.</p>
                <a href="/login" class="inline-block rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 px-6 py-2.5 font-bold text-white shadow-lg shadow-cyan-500/25 hover:scale-105 transition">
                    Login to Continue
                </a>
            </div>

        <% } %>

    </div>

</body>

</html>
