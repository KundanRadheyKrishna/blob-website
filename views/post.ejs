<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Post | Social</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/js/animations.js" defer></script>
    <style>
        /* Burgundy Button Micro-Interactions */
        .btn-burgundy {
            position: relative;
            overflow: hidden;
            background-color: #800020;
            color: #ffffff;
            cursor: pointer;
            isolation: isolate;
            transition: transform 0.15s ease;
        }

        .btn-burgundy::before {
            content: '';
            position: absolute;
            inset: 0;
            background-color: #9f1239;
            transform: scaleX(0);
            transform-origin: left center;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 0;
        }

        .btn-burgundy:hover::before {
            transform: scaleX(1);
        }

        .btn-burgundy:active {
            transform: scale(0.95);
        }

        .btn-burgundy > * {
            position: relative;
            z-index: 1;
        }

        /* Drag over Burgundy accent override */
        #dropzone.border-cyan-400 {
            border-color: #9f1239 !important;
            background-color: rgba(159, 18, 57, 0.15) !important;
        }

        /* From Uiverse.io by chicogale - https://uiverse.io/chicogale/brown-panda-75 | MIT License, Copyright (c) chicogale (federico) */
        .cyber-toggle-wrapper {
            display: inline-flex;
            align-items: center;
            padding: 2px 4px;
        }

        .cyber-toggle {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 26px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .cyber-toggle-input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
        }

        .cyber-toggle-slider {
            position: absolute;
            inset: 0;
            background-color: #141416;
            border: 1px solid #26262b;
            border-radius: 26px;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.6);
            overflow: hidden;
        }

        /* Glowing Cyber Dots / Particles inside the track */
        .cyber-particles {
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .cyber-dot {
            position: absolute;
            border-radius: 50%;
            background-color: #52525b;
            opacity: 0.3;
            transition: all 0.35s ease;
        }

        .cyber-dot.p1 { width: 3px; height: 3px; top: 6px; left: 13px; }
        .cyber-dot.p2 { width: 3.5px; height: 3.5px; bottom: 5px; left: 21px; }
        .cyber-dot.p3 { width: 3px; height: 3px; top: 7px; right: 17px; }
        .cyber-dot.p4 { width: 2.5px; height: 2.5px; bottom: 6px; right: 10px; }

        /* The Moving Thumb */
        .cyber-thumb {
            position: absolute;
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background: #d4d4d8;
            border-radius: 50%;
            transition: transform 0.35s cubic-bezier(0.68, -0.2, 0.265, 1.35),
                        background 0.35s ease,
                        box-shadow 0.35s ease;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
            z-index: 2;
        }

        /* Active / Checked State - Adapted from cyan/purple to Burgundy palette (#800020 / #9f1239) */
        .cyber-toggle-input:checked + .cyber-toggle-slider {
            background-color: #1a080f;
            border-color: #9f1239;
            box-shadow: 0 0 12px rgba(159, 18, 57, 0.45),
                        inset 0 0 6px rgba(128, 0, 32, 0.35);
        }

        .cyber-toggle-input:checked + .cyber-toggle-slider .cyber-thumb {
            transform: translateX(22px);
            background: linear-gradient(135deg, #800020, #9f1239);
            box-shadow: 0 0 10px #9f1239, 0 0 18px rgba(225, 29, 72, 0.55);
        }

        .cyber-toggle-input:checked + .cyber-toggle-slider .cyber-dot {
            background-color: #fb7185;
            opacity: 0.95;
            box-shadow: 0 0 6px #e11d48;
        }

        .cyber-toggle-input:checked + .cyber-toggle-slider .cyber-dot.p1 {
            transform: scale(1.3) translateY(-1px);
        }
        .cyber-toggle-input:checked + .cyber-toggle-slider .cyber-dot.p2 {
            transform: scale(1.2) translateX(1px);
        }
        .cyber-toggle-input:checked + .cyber-toggle-slider .cyber-dot.p3 {
            transform: scale(1.4) translateY(1px);
        }
        .cyber-toggle-input:checked + .cyber-toggle-slider .cyber-dot.p4 {
            transform: scale(1.2) translateX(-1px);
        }

        .cyber-toggle:hover .cyber-toggle-slider {
            border-color: #9f1239;
        }
    </style>
</head>

<body class="min-h-screen bg-[#0a0a0a] text-neutral-200 flex items-center justify-center p-4">

    <div class="w-full max-w-xl">

        <div class="mb-6 flex items-center justify-between">
            <a href="/" id="back-link" class="flex items-center gap-2 text-sm font-medium text-neutral-400 hover:text-white transition-colors cursor-pointer">
                &larr; Back to Feed
            </a>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#800020]/20 text-rose-300 border border-[#800020]/40">
                New Post
            </span>
        </div>

        <% if (isLoggedIn) { %>

            <form id="post-form" action="/posts" enctype="multipart/form-data" method="POST"
                class="rounded-2xl border border-neutral-800 bg-[#121212] p-6 sm:p-8 shadow-xl">

                <h1 class="text-2xl font-bold tracking-tight text-white mb-6">
                    Share with the Community
                </h1>

                <!-- Inline Error Alert Banner -->
                <div id="form-error-banner" class="hidden mb-5 items-center justify-between gap-3 p-3.5 rounded-xl bg-[#800020]/20 border border-[#9f1239] text-rose-300 text-sm">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-5 h-5 shrink-0 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span id="form-error-text"></span>
                    </div>
                    <button type="button" id="close-error-banner" class="text-rose-400 hover:text-white p-1 rounded-md transition-colors cursor-pointer" title="Dismiss error">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <!-- Content Area -->
                <div class="mb-5">
                    <textarea name="content" placeholder="What's happening in your universe?" maxlength="2000" required
                        class="min-h-36 w-full resize-y rounded-xl border border-neutral-800 bg-neutral-900/90 p-4 text-neutral-100 placeholder-neutral-500 outline-none transition-colors focus:border-[#800020] focus:ring-1 focus:ring-[#800020] leading-relaxed"></textarea>
                </div>

                <!-- Attachment Area -->
                <div class="mb-6">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-2">
                        Attachment (Optional)
                    </label>

                    <div class="flex flex-wrap items-center gap-3">
                        <label id="dropzone" for="image"
                            class="btn-burgundy cursor-pointer inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white shadow-sm active:scale-95 transition-transform">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            <span>Select Image</span>
                        </label>
                        <input type="file" id="image" accept="image/jpeg,image/png,image/webp" class="sr-only">
                        <input type="hidden" name="imageUrl" id="imageUrl">
                        <input type="hidden" name="publicId" id="publicId">

                        <!-- From Uiverse.io by chicogale - https://uiverse.io/chicogale/brown-panda-75 | MIT License, Copyright (c) chicogale (federico) -->
                        <div class="cyber-toggle-wrapper flex items-center gap-2.5 bg-neutral-900/80 px-3 py-1.5 rounded-lg border border-neutral-800">
                            <label class="cyber-toggle" for="auto-caption-toggle" title="Toggle AI Auto-Captioning">
                                <input type="checkbox" id="auto-caption-toggle" name="autoCaption" checked class="cyber-toggle-input">
                                <span class="cyber-toggle-slider">
                                    <span class="cyber-particles">
                                        <span class="cyber-dot p1"></span>
                                        <span class="cyber-dot p2"></span>
                                        <span class="cyber-dot p3"></span>
                                        <span class="cyber-dot p4"></span>
                                    </span>
                                    <span class="cyber-thumb"></span>
                                </span>
                            </label>
                            <label for="auto-caption-toggle" class="cyber-toggle-label text-xs font-semibold text-neutral-300 cursor-pointer select-none">AI Auto-Caption</label>
                        </div>

                        <span id="file-name" class="text-xs text-neutral-400 truncate max-w-xs">Supports JPG, PNG, WEBP (Max 5MB)</span>
                    </div>

                    <!-- Live Image Preview (0s Instant Preview with Remove Option) -->
                    <div id="preview-wrapper" class="mt-4 hidden items-center gap-3">
                        <div id="preview-container" class="relative w-48 h-32 rounded-lg overflow-hidden border border-neutral-800 bg-neutral-900 shadow-md">
                            <img id="preview-image" src="" alt="Preview" class="w-full h-full object-cover">
                            <button type="button" id="remove-image-btn" title="Remove image"
                                class="absolute top-2 right-2 bg-black/80 hover:bg-[#800020] text-white p-1 rounded-full transition-colors cursor-pointer border border-neutral-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </div>
                        <button type="button" id="clear-image-btn" class="text-xs text-neutral-400 hover:text-rose-400 underline cursor-pointer transition-colors">
                            Remove image
                        </button>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex items-center justify-between pt-4 border-t border-neutral-800">
                    <a href="/" id="cancel-btn" class="rounded-lg border border-neutral-800 bg-neutral-900 px-5 py-2.5 text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors cursor-pointer">
                        Cancel
                    </a>

                    <button type="submit" id="publish-btn"
                        class="btn-burgundy cursor-pointer rounded-lg px-6 py-2.5 text-sm font-semibold text-white shadow-md active:scale-95 transition-transform disabled:opacity-50 disabled:cursor-not-allowed">
                        <span id="publish-btn-text" class="flex items-center gap-2">
                            <span>Publish Post &rarr;</span>
                        </span>
                    </button>
                </div>

            </form>

        <% } else { %>

            <div class="rounded-2xl border border-neutral-800 bg-[#121212] p-8 text-center shadow-xl">
                <h2 class="text-xl font-bold text-white mb-2">Authentication Required</h2>
                <p class="text-sm text-neutral-400 mb-6">Please login to create and publish posts.</p>
                <a href="/login" class="btn-burgundy cursor-pointer inline-flex items-center justify-center rounded-lg px-6 py-2.5 text-sm font-semibold text-white shadow-md active:scale-95 transition-transform">
                    <span>Login to Continue</span>
                </a>
            </div>

        <% } %>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const postForm = document.getElementById('post-form');
            const contentTextarea = document.querySelector('textarea[name="content"]');
            const autoCaptionToggle = document.getElementById('auto-caption-toggle');
            const dropzone = document.getElementById('dropzone');
            const fileInput = document.getElementById('image');
            const fileName = document.getElementById('file-name');
            const previewWrapper = document.getElementById('preview-wrapper');
            const previewImage = document.getElementById('preview-image');
            const removeImageBtn = document.getElementById('remove-image-btn');
            const clearImageBtn = document.getElementById('clear-image-btn');
            const cancelBtn = document.getElementById('cancel-btn');
            const backLink = document.getElementById('back-link');
            const publishBtn = document.getElementById('publish-btn');
            const publishBtnText = document.getElementById('publish-btn-text');
            const imageUrlInput = document.getElementById('imageUrl');
            const publicIdInput = document.getElementById('publicId');
            const formErrorBanner = document.getElementById('form-error-banner');
            const formErrorText = document.getElementById('form-error-text');
            const closeErrorBanner = document.getElementById('close-error-banner');

            let uploadPromise = null;
            let previewUrl = null;
            let isSubmitting = false;
            let uploadAbortController = null;
            let captionInterval = null;
            let isAutoCaptioning = false;
            let captionRequestId = 0;

            function showFormError(message) {
                if (formErrorText) formErrorText.textContent = message;
                if (formErrorBanner) {
                    formErrorBanner.classList.remove('hidden');
                    formErrorBanner.classList.add('flex');
                }
            }

            function hideFormError() {
                if (formErrorBanner) {
                    formErrorBanner.classList.add('hidden');
                    formErrorBanner.classList.remove('flex');
                }
            }

            if (closeErrorBanner) {
                closeErrorBanner.addEventListener('click', hideFormError);
            }

            function disableDropzone() {
                if (dropzone) {
                    dropzone.classList.add('pointer-events-none', 'opacity-50', 'cursor-not-allowed');
                }
                if (fileInput) {
                    fileInput.disabled = true;
                }
            }

            function enableDropzone() {
                if (dropzone) {
                    dropzone.classList.remove('pointer-events-none', 'opacity-50', 'cursor-not-allowed');
                }
                if (fileInput) {
                    fileInput.disabled = false;
                }
            }

            function startAutoCaptionAnimation() {
                if (captionInterval) {
                    clearInterval(captionInterval);
                    captionInterval = null;
                }
                isAutoCaptioning = true;
                if (contentTextarea) {
                    contentTextarea.readOnly = true;
                    const baseText = 'Auto-caption is in progress';
                    let dotCount = 3;
                    contentTextarea.value = baseText + '...';
                    captionInterval = setInterval(() => {
                        dotCount = (dotCount % 3) + 1;
                        contentTextarea.value = baseText + '.'.repeat(dotCount);
                    }, 400);
                }
            }

            function stopAutoCaptioning(clearProgressText = true) {
                if (captionInterval) {
                    clearInterval(captionInterval);
                    captionInterval = null;
                }
                if (contentTextarea) {
                    contentTextarea.readOnly = false;
                    if (clearProgressText && contentTextarea.value.startsWith('Auto-caption is in progress')) {
                        contentTextarea.value = '';
                    }
                }
                isAutoCaptioning = false;
            }

            if (autoCaptionToggle) {
                autoCaptionToggle.addEventListener('change', async () => {
                    if (!autoCaptionToggle.checked) {
                        // Immediately stop running interval, unlock textarea, clear in-progress placeholder,
                        // and ignore any late-arriving caption from an in-flight upload
                        captionRequestId++;
                        stopAutoCaptioning(true);
                    } else {
                        // Toggled ON: if image already selected and textarea is empty, request caption
                        if (imageUrlInput && imageUrlInput.value && contentTextarea && !contentTextarea.value.trim()) {
                            const currentReqId = ++captionRequestId;
                            startAutoCaptionAnimation();
                            try {
                                const res = await fetch('/api/generate-caption', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ imageUrl: imageUrlInput.value })
                                });
                                const data = await res.json().catch(() => ({}));
                                // Ignore if user toggled OFF in the meantime or newer request started
                                if (currentReqId !== captionRequestId || !autoCaptionToggle.checked) {
                                    return;
                                }
                                const shouldPopulate = contentTextarea && (contentTextarea.value.startsWith('Auto-caption is in progress') || !contentTextarea.value.trim());
                                stopAutoCaptioning(false);
                                if (data && data.caption && shouldPopulate) {
                                    contentTextarea.value = data.caption;
                                } else if (shouldPopulate) {
                                    contentTextarea.value = '';
                                }
                            } catch (err) {
                                if (currentReqId === captionRequestId) {
                                    stopAutoCaptioning(true);
                                }
                            }
                        }
                    }
                });
            }

            function deleteImageOnServer(id, useBeacon = false) {
                if (!id) return;
                const url = '/api/delete-image';
                const payload = JSON.stringify({ publicId: id });

                if (useBeacon && navigator.sendBeacon) {
                    const blob = new Blob([payload], { type: 'application/json' });
                    navigator.sendBeacon(url, blob);
                } else {
                    fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload,
                        keepalive: true
                    }).catch(() => {});
                }
            }

            function clearSelectedImage() {
                captionRequestId++;
                stopAutoCaptioning(true);
                enableDropzone();

                if (uploadAbortController) {
                    uploadAbortController.abort();
                    uploadAbortController = null;
                }
                uploadPromise = null;

                const currentPublicId = publicIdInput ? publicIdInput.value : null;
                if (currentPublicId) {
                    deleteImageOnServer(currentPublicId, false);
                }

                if (imageUrlInput) imageUrlInput.value = '';
                if (publicIdInput) publicIdInput.value = '';

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                if (fileInput) {
                    fileInput.value = '';
                }

                if (previewWrapper) {
                    previewWrapper.classList.add('hidden');
                    previewWrapper.classList.remove('flex');
                }

                if (previewImage) {
                    previewImage.src = '';
                }

                if (fileName) {
                    fileName.textContent = 'Supports JPG, PNG, WEBP (Max 5MB)';
                    fileName.classList.remove('text-neutral-200');
                    fileName.classList.add('text-neutral-400');
                }
            }

            if (removeImageBtn) {
                removeImageBtn.addEventListener('click', clearSelectedImage);
            }
            if (clearImageBtn) {
                clearImageBtn.addEventListener('click', clearSelectedImage);
            }

            if (fileInput) {
                fileInput.addEventListener('change', () => {
                    if (!fileInput.files || !fileInput.files[0]) {
                        return;
                    }

                    const file = fileInput.files[0];

                    // Disable dropzone label and input while image is active
                    disableDropzone();
                    hideFormError();

                    // Clean up previous image, auto-caption & abort prior upload if any
                    captionRequestId++;
                    const currentReqId = captionRequestId;
                    stopAutoCaptioning(true);

                    if (uploadAbortController) {
                        uploadAbortController.abort();
                        uploadAbortController = null;
                    }
                    const previousPublicId = publicIdInput ? publicIdInput.value : null;
                    if (previousPublicId) {
                        deleteImageOnServer(previousPublicId, false);
                    }
                    if (imageUrlInput) imageUrlInput.value = '';
                    if (publicIdInput) publicIdInput.value = '';

                    if (previewUrl) {
                        URL.revokeObjectURL(previewUrl);
                        previewUrl = null;
                    }

                    // Update filename display
                    if (fileName) {
                        fileName.textContent = file.name;
                        fileName.classList.remove('text-neutral-400');
                        fileName.classList.add('text-neutral-200');
                    }

                    // 1. Instant 0s Preview using URL.createObjectURL(file)
                    previewUrl = URL.createObjectURL(file);
                    if (previewImage) {
                        previewImage.src = previewUrl;
                    }
                    if (previewWrapper) {
                        previewWrapper.classList.remove('hidden');
                        previewWrapper.classList.add('flex');
                    }

                    // Check if AI Auto-Caption is ON and textarea is empty
                    const isAutoCaptionOn = autoCaptionToggle ? autoCaptionToggle.checked : false;

                    if (isAutoCaptionOn && contentTextarea && !contentTextarea.value.trim()) {
                        startAutoCaptionAnimation();
                    }

                    // 2. Background Upload to POST /api/upload-image
                    const formData = new FormData();
                    formData.append('image', file);
                    formData.append('autoCaption', isAutoCaptionOn ? 'true' : 'false');

                    const abortController = new AbortController();
                    uploadAbortController = abortController;

                    uploadPromise = fetch('/api/upload-image', {
                        method: 'POST',
                        body: formData,
                        signal: abortController.signal
                    })
                    .then(async (response) => {
                        if (!response.ok) {
                            const errData = await response.json().catch(() => ({}));
                            throw new Error(errData.error || 'Upload failed');
                        }
                        return response.json();
                    })
                    .then((data) => {
                        if (data && data.imageUrl && data.publicId) {
                            if (imageUrlInput) imageUrlInput.value = data.imageUrl;
                            if (publicIdInput) publicIdInput.value = data.publicId;
                        }

                        // Handle caption response only if this request is still active and toggle is ON
                        if (currentReqId === captionRequestId && autoCaptionToggle && autoCaptionToggle.checked) {
                            if (isAutoCaptioning) {
                                const isStillProgressText = contentTextarea && (contentTextarea.value.startsWith('Auto-caption is in progress') || !contentTextarea.value.trim());
                                stopAutoCaptioning(false);
                                if (data && data.caption && isStillProgressText) {
                                    contentTextarea.value = data.caption;
                                } else if (isStillProgressText) {
                                    contentTextarea.value = '';
                                }
                            }
                        } else {
                            // If auto-caption was turned OFF in the meantime, ignore late-arriving caption
                            if (contentTextarea && contentTextarea.value.startsWith('Auto-caption is in progress')) {
                                stopAutoCaptioning(true);
                            }
                        }

                        return data;
                    })
                    .catch((error) => {
                        if (error.name === 'AbortError') {
                            return null;
                        }
                        if (currentReqId === captionRequestId) {
                            stopAutoCaptioning(true);
                        }
                        console.error('Image upload error:', error);
                        throw error;
                    })
                    .finally(() => {
                        uploadPromise = null;
                        uploadAbortController = null;
                    });
                });
            }

            // Cleanup on Cancel / Back navigation
            if (cancelBtn) {
                cancelBtn.addEventListener('click', () => {
                    captionRequestId++;
                    stopAutoCaptioning(true);
                    const id = publicIdInput ? publicIdInput.value : null;
                    if (id) {
                        deleteImageOnServer(id, true);
                        publicIdInput.value = '';
                    }
                });
            }

            if (backLink) {
                backLink.addEventListener('click', () => {
                    captionRequestId++;
                    stopAutoCaptioning(true);
                    const id = publicIdInput ? publicIdInput.value : null;
                    if (id) {
                        deleteImageOnServer(id, true);
                        publicIdInput.value = '';
                    }
                });
            }

            window.addEventListener('pagehide', () => {
                const id = publicIdInput ? publicIdInput.value : null;
                if (!isSubmitting && id) {
                    deleteImageOnServer(id, true);
                }
            });

            window.addEventListener('beforeunload', () => {
                const id = publicIdInput ? publicIdInput.value : null;
                if (!isSubmitting && id) {
                    deleteImageOnServer(id, true);
                }
            });

            function resetPublishBtn() {
                if (publishBtn) {
                    publishBtn.disabled = false;
                }
                if (publishBtnText) {
                    publishBtnText.innerHTML = '<span>Publish Post &rarr;</span>';
                }
                isSubmitting = false;
            }

            // Form Submit: Await uploadPromise, validate client-side, submit via fetch to avoid raw 400/500 screens
            if (postForm) {
                postForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    hideFormError();

                    // Immediately disable the button and show "Publishing..." loading animation
                    if (publishBtn) {
                        publishBtn.disabled = true;
                    }
                    if (publishBtnText) {
                        publishBtnText.innerHTML = `
                            <svg class="animate-spin h-4 w-4 text-white shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                            </svg>
                            <span>Publishing...</span>
                        `;
                    }

                    // Await background upload if ongoing to prevent race condition
                    if (uploadPromise) {
                        try {
                            await uploadPromise;
                        } catch (error) {
                            showFormError('Image upload failed: ' + (error.message || 'Please try selecting the image again.'));
                            resetPublishBtn();
                            return;
                        }
                    }

                    if (contentTextarea && contentTextarea.value.startsWith('Auto-caption is in progress')) {
                        contentTextarea.value = '';
                    }

                    const content = contentTextarea ? contentTextarea.value.trim() : '';

                    // Client validation before submit
                    if (!content) {
                        showFormError('Post content cannot be empty.');
                        resetPublishBtn();
                        return;
                    }

                    if (content.length > 2000) {
                        showFormError('Post content exceeds the 2,000 character limit.');
                        resetPublishBtn();
                        return;
                    }

                    const imageUrl = imageUrlInput ? imageUrlInput.value : null;
                    const publicId = publicIdInput ? publicIdInput.value : null;

                    try {
                        const response = await fetch('/posts', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({ content, imageUrl, publicId })
                        });

                        const data = await response.json().catch(() => ({}));

                        if (!response.ok) {
                            showFormError(data.error || 'Unable to create post. Please try again.');
                            resetPublishBtn();
                            return;
                        }

                        isSubmitting = true;
                        window.location.href = data.redirectUrl || '/';
                    } catch (err) {
                        console.error('Post submit error:', err);
                        showFormError('Network error while creating post. Please try again.');
                        resetPublishBtn();
                    }
                });
            }
        });
    </script>
</body>

</html>
