<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Post | Social</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/js/animations.js" defer></script>
    <style>
        /* Burgundy Button Micro-Interactions */
        .btn-burgundy {
            position: relative;
            overflow: hidden;
            background-color: #800020;
            color: #ffffff;
            cursor: pointer;
            isolation: isolate;
            transition: transform 0.15s ease;
        }

        .btn-burgundy::before {
            content: '';
            position: absolute;
            inset: 0;
            background-color: #9f1239;
            transform: scaleX(0);
            transform-origin: left center;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 0;
        }

        .btn-burgundy:hover::before {
            transform: scaleX(1);
        }

        .btn-burgundy:active {
            transform: scale(0.95);
        }

        .btn-burgundy > * {
            position: relative;
            z-index: 1;
        }

        /* Drag over Burgundy accent override */
        #dropzone.border-cyan-400 {
            border-color: #9f1239 !important;
            background-color: rgba(159, 18, 57, 0.15) !important;
        }
    </style>
</head>

<body class="min-h-screen bg-[#0a0a0a] text-neutral-200 flex items-center justify-center p-4">

    <div class="w-full max-w-xl">

        <div class="mb-6 flex items-center justify-between">
            <a href="/" id="back-link" class="flex items-center gap-2 text-sm font-medium text-neutral-400 hover:text-white transition-colors cursor-pointer">
                &larr; Back to Feed
            </a>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#800020]/20 text-rose-300 border border-[#800020]/40">
                New Post
            </span>
        </div>

        <% if (isLoggedIn) { %>

            <form id="post-form" action="/posts" enctype="multipart/form-data" method="POST"
                class="rounded-2xl border border-neutral-800 bg-[#121212] p-6 sm:p-8 shadow-xl">

                <h1 class="text-2xl font-bold tracking-tight text-white mb-6">
                    Share with the Community
                </h1>

                <!-- Content Area -->
                <div class="mb-5">
                    <textarea name="content" placeholder="What's happening in your universe?" maxlength="2000" required
                        class="min-h-36 w-full resize-y rounded-xl border border-neutral-800 bg-neutral-900/90 p-4 text-neutral-100 placeholder-neutral-500 outline-none transition-colors focus:border-[#800020] focus:ring-1 focus:ring-[#800020] leading-relaxed"></textarea>
                </div>

                <!-- Attachment Area -->
                <div class="mb-6">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-2">
                        Attachment (Optional)
                    </label>

                    <div class="flex flex-wrap items-center gap-3">
                        <label id="dropzone" for="image"
                            class="btn-burgundy cursor-pointer inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white shadow-sm active:scale-95 transition-transform">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            <span>Select Image</span>
                        </label>
                        <input type="file" id="image" accept="image/jpeg,image/png,image/webp" class="sr-only">
                        <input type="hidden" name="imageUrl" id="imageUrl">
                        <input type="hidden" name="publicId" id="publicId">
                        <span id="file-name" class="text-xs text-neutral-400 truncate max-w-xs">Supports JPG, PNG, WEBP (Max 5MB)</span>
                    </div>

                    <!-- Live Image Preview (0s Instant Preview with Remove Option) -->
                    <div id="preview-wrapper" class="mt-4 hidden items-center gap-3">
                        <div id="preview-container" class="relative w-48 h-32 rounded-lg overflow-hidden border border-neutral-800 bg-neutral-900 shadow-md">
                            <img id="preview-image" src="" alt="Preview" class="w-full h-full object-cover">
                            <button type="button" id="remove-image-btn" title="Remove image"
                                class="absolute top-2 right-2 bg-black/80 hover:bg-[#800020] text-white p-1 rounded-full transition-colors cursor-pointer border border-neutral-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </div>
                        <button type="button" id="clear-image-btn" class="text-xs text-neutral-400 hover:text-rose-400 underline cursor-pointer transition-colors">
                            Remove image
                        </button>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex items-center justify-between pt-4 border-t border-neutral-800">
                    <a href="/" id="cancel-btn" class="rounded-lg border border-neutral-800 bg-neutral-900 px-5 py-2.5 text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors cursor-pointer">
                        Cancel
                    </a>

                    <button type="submit" id="publish-btn"
                        class="btn-burgundy cursor-pointer rounded-lg px-6 py-2.5 text-sm font-semibold text-white shadow-md active:scale-95 transition-transform disabled:opacity-50 disabled:cursor-not-allowed">
                        <span id="publish-btn-text" class="flex items-center gap-2">
                            <span>Publish Post &rarr;</span>
                        </span>
                    </button>
                </div>

            </form>

        <% } else { %>

            <div class="rounded-2xl border border-neutral-800 bg-[#121212] p-8 text-center shadow-xl">
                <h2 class="text-xl font-bold text-white mb-2">Authentication Required</h2>
                <p class="text-sm text-neutral-400 mb-6">Please login to create and publish posts.</p>
                <a href="/login" class="btn-burgundy cursor-pointer inline-flex items-center justify-center rounded-lg px-6 py-2.5 text-sm font-semibold text-white shadow-md active:scale-95 transition-transform">
                    <span>Login to Continue</span>
                </a>
            </div>

        <% } %>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const postForm = document.getElementById('post-form');
            const fileInput = document.getElementById('image');
            const fileName = document.getElementById('file-name');
            const previewWrapper = document.getElementById('preview-wrapper');
            const previewImage = document.getElementById('preview-image');
            const removeImageBtn = document.getElementById('remove-image-btn');
            const clearImageBtn = document.getElementById('clear-image-btn');
            const cancelBtn = document.getElementById('cancel-btn');
            const backLink = document.getElementById('back-link');
            const publishBtn = document.getElementById('publish-btn');
            const publishBtnText = document.getElementById('publish-btn-text');
            const imageUrlInput = document.getElementById('imageUrl');
            const publicIdInput = document.getElementById('publicId');

            let uploadPromise = null;
            let previewUrl = null;
            let isSubmitting = false;
            let uploadAbortController = null;

            function deleteImageOnServer(id, useBeacon = false) {
                if (!id) return;
                const url = '/api/delete-image';
                const payload = JSON.stringify({ publicId: id });

                if (useBeacon && navigator.sendBeacon) {
                    const blob = new Blob([payload], { type: 'application/json' });
                    navigator.sendBeacon(url, blob);
                } else {
                    fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload,
                        keepalive: true
                    }).catch(() => {});
                }
            }

            function clearSelectedImage() {
                if (uploadAbortController) {
                    uploadAbortController.abort();
                    uploadAbortController = null;
                }
                uploadPromise = null;

                const currentPublicId = publicIdInput ? publicIdInput.value : null;
                if (currentPublicId) {
                    deleteImageOnServer(currentPublicId, false);
                }

                if (imageUrlInput) imageUrlInput.value = '';
                if (publicIdInput) publicIdInput.value = '';

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                if (fileInput) {
                    fileInput.value = '';
                }

                if (previewWrapper) {
                    previewWrapper.classList.add('hidden');
                    previewWrapper.classList.remove('flex');
                }

                if (previewImage) {
                    previewImage.src = '';
                }

                if (fileName) {
                    fileName.textContent = 'Supports JPG, PNG, WEBP (Max 5MB)';
                    fileName.classList.remove('text-neutral-200');
                    fileName.classList.add('text-neutral-400');
                }
            }

            if (removeImageBtn) {
                removeImageBtn.addEventListener('click', clearSelectedImage);
            }
            if (clearImageBtn) {
                clearImageBtn.addEventListener('click', clearSelectedImage);
            }

            if (fileInput) {
                fileInput.addEventListener('change', () => {
                    if (!fileInput.files || !fileInput.files[0]) {
                        return;
                    }

                    const file = fileInput.files[0];

                    // Clean up previous image & abort prior upload if any
                    if (uploadAbortController) {
                        uploadAbortController.abort();
                        uploadAbortController = null;
                    }
                    const previousPublicId = publicIdInput ? publicIdInput.value : null;
                    if (previousPublicId) {
                        deleteImageOnServer(previousPublicId, false);
                    }
                    if (imageUrlInput) imageUrlInput.value = '';
                    if (publicIdInput) publicIdInput.value = '';

                    if (previewUrl) {
                        URL.revokeObjectURL(previewUrl);
                        previewUrl = null;
                    }

                    // Update filename display
                    if (fileName) {
                        fileName.textContent = file.name;
                        fileName.classList.remove('text-neutral-400');
                        fileName.classList.add('text-neutral-200');
                    }

                    // 1. Instant 0s Preview using URL.createObjectURL(file)
                    previewUrl = URL.createObjectURL(file);
                    if (previewImage) {
                        previewImage.src = previewUrl;
                    }
                    if (previewWrapper) {
                        previewWrapper.classList.remove('hidden');
                        previewWrapper.classList.add('flex');
                    }

                    // 2. Background Upload to POST /api/upload-image
                    const formData = new FormData();
                    formData.append('image', file);

                    const abortController = new AbortController();
                    uploadAbortController = abortController;

                    uploadPromise = fetch('/api/upload-image', {
                        method: 'POST',
                        body: formData,
                        signal: abortController.signal
                    })
                    .then(async (response) => {
                        if (!response.ok) {
                            const errData = await response.json().catch(() => ({}));
                            throw new Error(errData.error || 'Upload failed');
                        }
                        return response.json();
                    })
                    .then((data) => {
                        if (data && data.imageUrl && data.publicId) {
                            if (imageUrlInput) imageUrlInput.value = data.imageUrl;
                            if (publicIdInput) publicIdInput.value = data.publicId;
                        }
                        return data;
                    })
                    .catch((error) => {
                        if (error.name === 'AbortError') {
                            return null;
                        }
                        console.error('Image upload error:', error);
                        throw error;
                    })
                    .finally(() => {
                        uploadPromise = null;
                        uploadAbortController = null;
                    });
                });
            }

            // Cleanup on Cancel / Back navigation
            if (cancelBtn) {
                cancelBtn.addEventListener('click', () => {
                    const id = publicIdInput ? publicIdInput.value : null;
                    if (id) {
                        deleteImageOnServer(id, true);
                        publicIdInput.value = '';
                    }
                });
            }

            if (backLink) {
                backLink.addEventListener('click', () => {
                    const id = publicIdInput ? publicIdInput.value : null;
                    if (id) {
                        deleteImageOnServer(id, true);
                        publicIdInput.value = '';
                    }
                });
            }

            window.addEventListener('pagehide', () => {
                const id = publicIdInput ? publicIdInput.value : null;
                if (!isSubmitting && id) {
                    deleteImageOnServer(id, true);
                }
            });

            window.addEventListener('beforeunload', () => {
                const id = publicIdInput ? publicIdInput.value : null;
                if (!isSubmitting && id) {
                    deleteImageOnServer(id, true);
                }
            });

            // Form Submit: Await uploadPromise & show "Publishing..." animation
            if (postForm) {
                postForm.addEventListener('submit', async (e) => {
                    e.preventDefault();

                    // Immediately disable the button and show "Publishing..." loading animation
                    if (publishBtn) {
                        publishBtn.disabled = true;
                    }
                    if (publishBtnText) {
                        publishBtnText.innerHTML = `
                            <svg class="animate-spin h-4 w-4 text-white shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                            </svg>
                            <span>Publishing...</span>
                        `;
                    }

                    // Await background upload if ongoing to prevent race condition
                    if (uploadPromise) {
                        try {
                            await uploadPromise;
                        } catch (error) {
                            alert('Image upload failed: ' + (error.message || 'Please try selecting the image again.'));
                            if (publishBtn) {
                                publishBtn.disabled = false;
                            }
                            if (publishBtnText) {
                                publishBtnText.innerHTML = '<span>Publish Post &rarr;</span>';
                            }
                            return;
                        }
                    }

                    isSubmitting = true;
                    postForm.submit();
                });
            }
        });
    </script>
</body>

</html>
